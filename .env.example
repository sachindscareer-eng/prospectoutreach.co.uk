# Get an API key at https://resend.com — required for the contact form
RESEND_API_KEY=

# "From" address: use a domain you verify in Resend (e.g. ProspectOutreach <enquiries@yourdomain.com>)
# Without this, Resend trial may only allow sending to your own test address.
CONTACT_FROM_EMAIL=ProspectOutreach <enquiries@prospectoutreach.co.uk>
